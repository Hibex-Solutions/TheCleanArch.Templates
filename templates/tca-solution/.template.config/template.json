{
  "$schema": "http://json.schemastore.org/template",
  "author": "@TheCleanArch",
  "classifications": ["TheCleanArch", "Hibex-Solutions", "Solution"],
  "name": "TheCleanArch Solution",
  "description": "Diretório de solução com recursos básicos The Clean Arch",
  "identity": "TheCleanArch.Templates.BasicSolution",
  "shortName": "tca-solution",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "TheCleanArch.Templates.BasicSolution",
  "preferNameDirectory": true,
  "symbols": {
    "LicenseId": {
      "type": "parameter",
      "displayName": "License Id",
      "datatype": "choice",
      "defaultValue": "private",
      "choices": [
        {
          "choice": "private",
          "description": "Private"
        },
        {
          "choice": "apache-2.0",
          "description": "Apache License 2.0"
        },
        {
          "choice": "agpl-3.0",
          "description": "GNU Affero General Public License v3.0"
        },
        {
          "choice": "gpl-3.0",
          "description": "GNU General Public License v3.0"
        },
        {
          "choice": "lgpl-3.0",
          "description": "GNU Lesser General Public License v3.0"
        },
        {
          "choice": "mpl-2.0",
          "description": "Mozilla Public License 2.0"
        },
        {
          "choice": "mit",
          "description": "MIT License"
        },
        {
          "choice": "bsl-1.0",
          "description": "Boost Software License 1.0"
        },
        {
          "choice": "unlicense",
          "description": "The Unlicense"
        }
      ]
    },
    "LicenseIsPrivate": {
      "type": "computed",
      "value": "(LicenseId == 'private')"
    },
    "UseDevContainers": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Use Development Containers",
      "description": "If true, config files for Development Containers will be included in the solution."
    },
    "UseDomainDrivenDesign": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Use Domain-Driven Design (DDD) architectural pattern",
      "description": "If true, the solution will be structured following the Domain-Driven Design (DDD) principles."
    },
    "EnableOmnisharpExtensions": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Enable OmniSharp Extensions",
      "description": "If true, OmniSharp Extensions will be enabled in the generated projects."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(LicenseId != 'agpl-3.0')",
          "exclude": ["LICENSE.agpl-3.0.txt"]
        },
        {
          "condition": "(LicenseId != 'apache-2.0')",
          "exclude": ["LICENSE.apache-2.0.txt"]
        },
        {
          "condition": "(LicenseId != 'bsl-1.0')",
          "exclude": ["LICENSE.bsl-1.0.txt"]
        },
        {
          "condition": "(LicenseId != 'gpl-3.0')",
          "exclude": ["LICENSE.gpl-3.0.txt"]
        },
        {
          "condition": "(LicenseId != 'lgpl-3.0')",
          "exclude": ["LICENSE.lgpl-3.0.txt"]
        },
        {
          "condition": "(LicenseId != 'mit')",
          "exclude": ["LICENSE.mit.txt"]
        },
        {
          "condition": "(LicenseId != 'mpl-2.0')",
          "exclude": ["LICENSE.mpl-2.0.txt"]
        },
        {
          "condition": "(LicenseId != 'unlicense')",
          "exclude": ["LICENSE.unlicense.txt"]
        },
        {
          "condition": "(LicenseId == 'agpl-3.0')",
          "rename": {
            "LICENSE.agpl-3.0.txt": "LICENSE"
          }
        },
        {
          "condition": "(LicenseId == 'apache-2.0')",
          "rename": {
            "LICENSE.apache-2.0.txt": "LICENSE"
          }
        },
        {
          "condition": "(LicenseId == 'bsl-1.0')",
          "rename": {
            "LICENSE.bsl-1.0.txt": "LICENSE"
          }
        },
        {
          "condition": "(LicenseId == 'gpl-3.0')",
          "rename": {
            "LICENSE.gpl-3.0.txt": "LICENSE"
          }
        },
        {
          "condition": "(LicenseId == 'lgpl-3.0')",
          "rename": {
            "LICENSE.lgpl-3.0.txt": "LICENSE"
          }
        },
        {
          "condition": "(LicenseId == 'mit')",
          "rename": {
            "LICENSE.mit.txt": "LICENSE"
          }
        },
        {
          "condition": "(LicenseId == 'mpl-2.0')",
          "rename": {
            "LICENSE.mpl-2.0.txt": "LICENSE"
          }
        },
        {
          "condition": "(LicenseId == 'unlicense')",
          "rename": {
            "LICENSE.unlicense.txt": "LICENSE"
          }
        },
        {
          "condition": "(!UseDevContainers)",
          "exclude": [".devcontainer/**" ]
        },
        {
          "condition": "(!UseDomainDrivenDesign)",
          "exclude": [
            "src/TheCleanArch.Templates.BasicSolution.Domain/**",
            "test/TheCleanArch.Templates.BasicSolution.DomainTests/**"
          ]
        },
        {
          "condition": "(!EnableOmnisharpExtensions)",
          "exclude": [
            "omnisharp.json"
          ]
        }
      ]
    }
  ]
}
